apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  annotations:
    internal.istio.io/gateway-semantics: gateway
    internal.istio.io/gateway-service: rt-cluster-istio.default.svc.domain.suffix
    internal.istio.io/parents: Gateway/rt-cluster/http.default
    internal.istio.io/service-account-name: rt-cluster-istio
  name: rt-cluster~istio-autogenerated-k8s-gateway~http
  namespace: default
spec:
  servers:
  - hosts:
    - default/*
    port:
      name: default
      number: 80
      protocol: HTTP
---
