apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  annotations:
    internal.istio.io/gateway-semantics: gateway
    internal.istio.io/gateway-service: with-auto-passthrough-option.istio-system.svc.domain.suffix
    internal.istio.io/parents: Gateway/with-auto-passthrough-option/cross-network.istio-system
    internal.istio.io/service-account-name: with-auto-passthrough-option
  name: with-auto-passthrough-option~istio-autogenerated-k8s-gateway~cross-network
  namespace: istio-system
spec:
  servers:
  - hosts:
    - istio-system/*
    port:
      name: default
      number: 35443
      protocol: TLS
    tls:
      mode: AUTO_PASSTHROUGH
---
apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  annotations:
    internal.istio.io/gateway-semantics: gateway
    internal.istio.io/gateway-service: with-auto-passthrough.istio-system.svc.domain.suffix
    internal.istio.io/parents: Gateway/with-auto-passthrough/cross-network.istio-system
    internal.istio.io/service-account-name: with-auto-passthrough
  name: with-auto-passthrough~istio-autogenerated-k8s-gateway~cross-network
  namespace: istio-system
spec:
  servers:
  - hosts:
    - istio-system/*.local
    port:
      name: default
      number: 15443
      protocol: TLS
    tls:
      mode: AUTO_PASSTHROUGH
---
apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  annotations:
    internal.istio.io/gateway-semantics: gateway
    internal.istio.io/gateway-service: with-tls-passthrough.istio-system.svc.domain.suffix
    internal.istio.io/parents: Gateway/with-tls-passthrough/tls-passthrough.istio-system
    internal.istio.io/service-account-name: with-tls-passthrough
  name: with-tls-passthrough~istio-autogenerated-k8s-gateway~tls-passthrough
  namespace: istio-system
spec:
  servers:
  - hosts:
    - istio-system/*
    port:
      name: default
      number: 6443
      protocol: TLS
    tls: {}
---
