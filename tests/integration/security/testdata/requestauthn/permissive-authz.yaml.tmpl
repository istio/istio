apiVersion: security.istio.io/v1
kind: RequestAuthentication
metadata:
  name: {{ .To.ServiceName }}
spec:
  selector:
    matchLabels:
      app: {{ .To.ServiceName }}
  jwtRules:
  - issuer: "test-issuer-1@istio.io"
    jwksUri: "{{ .JWTServer.JwksURI }}"
    presence: PERMISSIVE
    fromHeaders:
    - name: "authorization"
      prefix: "Bearer "
---
# This policy denies requests without a populated principal. A 403 means the
# JWT filter passed the request and this policy denied it. A 401 means the
# filter itself rejected it.
apiVersion: security.istio.io/v1
kind: AuthorizationPolicy
metadata:
  name: {{ .To.ServiceName }}
spec:
  selector:
    matchLabels:
      app: {{ .To.ServiceName }}
  rules:
  - to:
    - operation:
        methods: ["GET"]
    from:
    - source:
        requestPrincipals: ["test-issuer-1@istio.io/sub-1"]
