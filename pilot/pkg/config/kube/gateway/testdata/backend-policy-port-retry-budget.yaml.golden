apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: XBackendTrafficPolicy/default.retry-policy,BackendTLSPolicy/default.tls-upstream-echo
  name: echo-port-budget~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: echo-port-budget.default.svc.domain.suffix
  trafficPolicy:
    loadBalancer: {}
    portLevelSettings:
    - port:
        number: 443
      retryBudget:
        budgetInterval: 10s
        minRetryConcurrency: 5
        percent: 30
      tls:
        credentialName: configmap://default/auth-cert
        mode: SIMPLE
        sni: auth.example.com
    retryBudget:
      budgetInterval: 10s
      minRetryConcurrency: 5
      percent: 30
---
