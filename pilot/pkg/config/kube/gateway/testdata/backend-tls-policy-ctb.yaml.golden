apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: BackendTLSPolicy/default.valid
  name: echo~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: echo.default.svc.domain.suffix
  trafficPolicy:
    tls:
      credentialName: clustertrustbundle://ca-bundle
      mode: SIMPLE
      sni: auth.example.com
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: BackendTLSPolicy/default.valid-signer-name
  name: example~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: example.default.svc.domain.suffix
  trafficPolicy:
    tls:
      credentialName: clustertrustbundle://example.com:signer:ca
      mode: SIMPLE
      sni: auth.example.com
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: BackendTLSPolicy/default.first-ref-only
  name: foo-svc~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: foo-svc.default.svc.domain.suffix
  trafficPolicy:
    tls:
      credentialName: clustertrustbundle://ca-bundle
      mode: SIMPLE
      sni: auth.example.com
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: BackendTLSPolicy/default.garbage
  name: httpbin-other~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: httpbin-other.default.svc.domain.suffix
  trafficPolicy:
    tls:
      credentialName: invalid://
      mode: SIMPLE
      sni: auth.example.com
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: BackendTLSPolicy/default.empty
  name: httpbin-second~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: httpbin-second.default.svc.domain.suffix
  trafficPolicy:
    tls:
      credentialName: invalid://
      mode: SIMPLE
      sni: auth.example.com
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: BackendTLSPolicy/default.not-found
  name: httpbin~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: httpbin.default.svc.domain.suffix
  trafficPolicy:
    tls:
      credentialName: invalid://
      mode: SIMPLE
      sni: auth.example.com
---
