apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  annotations:
    internal.istio.io/gateway-semantics: gateway
    internal.istio.io/gateway-service: cross-namespace-istio.bookinfo.svc.domain.suffix
    internal.istio.io/parents: Gateway/cross-namespace/https.bookinfo
    internal.istio.io/service-account-name: cross-namespace-istio
  name: cross-namespace~istio-autogenerated-k8s-gateway~https
  namespace: bookinfo
spec:
  servers:
  - hosts:
    - '*/cross-namespace.example.com'
    port:
      name: default
      number: 443
      protocol: HTTPS
    tls:
      caCertCredentialName: clustertrustbundle://ca-bundle
      credentialName: kubernetes-gateway://bookinfo/bookinfo-secret
      insecureSkipVerify: false
      mode: MUTUAL
---
apiVersion: networking.istio.io/v1
