apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  annotations:
    internal.istio.io/gateway-semantics: gateway
    internal.istio.io/gateway-service: istio-ingressgateway.istio-system.svc.domain.suffix
    internal.istio.io/parents: Gateway/gateway/default.istio-system
    internal.istio.io/service-account-name: ""
  name: gateway~istio-autogenerated-k8s-gateway~default
  namespace: istio-system
spec:
  servers:
  - hosts:
    - '*/*.domain.example'
    port:
      name: default
      number: 80
      protocol: HTTP
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/cross-namespace.default
    internal.istio.io/route-semantics: gateway
  name: istio-system~gateway~istio-autogenerated-k8s-gateway~default~cross.domain.example
  namespace: default
spec:
  gateways:
  - istio-system/gateway~istio-autogenerated-k8s-gateway~default
  hosts:
  - cross.domain.example
  http:
  - name: default.cross-namespace.0
    route:
    - destination:
        host: cross.example.net
        port:
          number: 80
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/matching-port.default
    internal.istio.io/route-semantics: gateway
  name: istio-system~gateway~istio-autogenerated-k8s-gateway~default~matching-port.domain.example
  namespace: default
spec:
  gateways:
  - istio-system/gateway~istio-autogenerated-k8s-gateway~default
  hosts:
  - matching-port.domain.example
  http:
  - name: default.matching-port.0
    route:
    - destination:
        host: google.com
        port:
          number: 80
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/mismatched-port.default
    internal.istio.io/route-semantics: gateway
  name: istio-system~gateway~istio-autogenerated-k8s-gateway~default~mismatched-port.domain.example
  namespace: default
spec:
  gateways:
  - istio-system/gateway~istio-autogenerated-k8s-gateway~default
  hosts:
  - mismatched-port.domain.example
  http:
  - name: default.mismatched-port.0
    route:
    - destination: {}
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/missing-backend.default
    internal.istio.io/route-semantics: gateway
  name: istio-system~gateway~istio-autogenerated-k8s-gateway~default~missing.domain.example
  namespace: default
spec:
  gateways:
  - istio-system/gateway~istio-autogenerated-k8s-gateway~default
  hosts:
  - missing.domain.example
  http:
  - name: default.missing-backend.0
    route:
    - destination: {}
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/no-port.default
    internal.istio.io/route-semantics: gateway
  name: istio-system~gateway~istio-autogenerated-k8s-gateway~default~no-port.domain.example
  namespace: default
spec:
  gateways:
  - istio-system/gateway~istio-autogenerated-k8s-gateway~default
  hosts:
  - no-port.domain.example
  http:
  - name: default.no-port.0
    route:
    - destination:
        host: secure.example.net
        port:
          number: 80
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/not-allowed.default
    internal.istio.io/route-semantics: gateway
  name: istio-system~gateway~istio-autogenerated-k8s-gateway~default~not-allowed.domain.example
  namespace: default
spec:
  gateways:
  - istio-system/gateway~istio-autogenerated-k8s-gateway~default
  hosts:
  - not-allowed.domain.example
  http:
  - name: default.not-allowed.0
    route:
    - destination: {}
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: XBackend/allowed-1.cross-namespace
  name: cross-namespace~cross-example-net~istio-autogenerated-k8s-gateway
  namespace: allowed-1
spec:
  host: cross.example.net
  trafficPolicy:
    tls:
      mode: SIMPLE
      sni: cross.example.net
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: XBackend/default.external-https
  name: external-https~secure-example-net~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: secure.example.net
  trafficPolicy:
    tls:
      credentialName: configmap://default/auth-cert
      mode: SIMPLE
      sni: auth.example.com
---
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  annotations:
    internal.istio.io/parents: XBackend/default.external-novalidation
  name: external-novalidation~google-com~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  host: google.com
  trafficPolicy:
    tls:
      mode: SIMPLE
      sni: google.com
---
