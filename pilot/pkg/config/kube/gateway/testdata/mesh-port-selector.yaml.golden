apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: HTTPRoute/name-and-port-agree.default,HTTPRoute/section-name.default
    internal.istio.io/route-semantics: gateway
  name: default~34000~echo-1.default.svc.domain.suffix
  namespace: default
spec:
  gateways:
  - mesh
  hosts:
  - echo-1.default.svc.domain.suffix
  http:
  - match:
    - port: 34000
    name: default.name-and-port-agree.0
    route:
    - destination:
        host: echo.default.svc.domain.suffix
        port:
          number: 80
  - match:
    - port: 34000
    name: default.section-name.0
    route:
    - destination:
        host: echo.default.svc.domain.suffix
        port:
          number: 80
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: GRPCRoute/grpc-section-name.default
    internal.istio.io/route-semantics: gateway
  name: default~80~echo-2.default.svc.domain.suffix
  namespace: default
spec:
  gateways:
  - mesh
  hosts:
  - echo-2.default.svc.domain.suffix
  http:
  - match:
    - port: 80
    name: default.grpc-section-name.0
    route:
    - destination:
        host: echo.default.svc.domain.suffix
        port:
          number: 80
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: TCPRoute/tcp-section-name.default
    internal.istio.io/route-semantics: gateway
  name: tcp-section-name~tcp~0~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  gateways:
  - mesh
  hosts:
  - echo-2.default.svc.domain.suffix
  tcp:
  - match:
    - port: 34000
    route:
    - destination:
        host: echo.default.svc.domain.suffix
        port:
          number: 80
---
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  annotations:
    internal.istio.io/parents: TLSRoute/tls-section-name.default
    internal.istio.io/route-semantics: gateway
  name: tls-section-name~tls~0~istio-autogenerated-k8s-gateway
  namespace: default
spec:
  gateways:
  - mesh
  hosts:
  - echo-port.default.svc.domain.suffix
  tls:
  - match:
    - port: 80
      sniHosts:
      - tls.example.com
    route:
    - destination:
        host: echo.default.svc.domain.suffix
        port:
          number: 80
---
